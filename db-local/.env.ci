# Committed on purpose: CI copies this to db-local/.env (.github/workflows/ci.yml).
# Throwaway values for a DB that lives only for one CI job. Never put a real secret here.
# Keep the keys in sync with .env.example.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=ci-root-pass

MONGO_DEV_USERNAME=catStoreDev
MONGO_DEV_PASSWORD=ci-dev-pass
MONGO_DEV_DATABASE=cats
MONGO_TEST_USERNAME=catStoreTest
MONGO_TEST_PASSWORD=ci-test-pass
MONGO_TEST_DATABASE=catsTest
