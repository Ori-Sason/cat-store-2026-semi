# Copy to .env.local (dev) and .env.test (tests). Same keys; .env.test uses the test user and database.
SEED_USERS_PASSWORD= # dev only - password for the seeded 'user' and 'admin' (npm run seed). Not needed in prod.
# Connect as the app user (MONGO_DEV_* / MONGO_TEST_* in db-local), never as root
MONGODB_URI='mongodb://USER:PASS@127.0.0.1:27017/?authSource=admin'
MONGODB_DATABASE=cats
JWT_SECRET= # generate: openssl rand -hex 32
