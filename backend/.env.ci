# Committed on purpose: CI copies this to backend/.env.test (.github/workflows/ci.yml).
# Throwaway values for a DB that lives only for one CI job. Never put a real secret here.
# Keep the keys in sync with .env.example. The user and password match db-local/.env.ci.
# Must pass the password rules in shared/src/models/user.ts, or the E2E seed fails
SEED_USERS_PASSWORD=Ci-seed-pass-1
MONGODB_URI='mongodb://catStoreTest:ci-test-pass@127.0.0.1:27017/?authSource=admin'
MONGODB_DATABASE=catsTest
JWT_SECRET=ci-jwt-secret
