{
  // Typecheck-only config - frontend (Vite) and backend (Node type stripping) consume the .ts sources directly
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, // both consumers strip types, so no enum/namespace/param-props
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
